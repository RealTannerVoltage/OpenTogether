{
  "cli": {
    "version": ">= 3.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "$EAS_ANDROID_SERVICE_ACCOUNT_KEY_PATH",
        "track": "production"
      },
      "ios": {
        "appleId": "$EAS_APPLE_ID",
        "ascAppId": "$EAS_ASC_APP_ID",
        "appleTeamId": "$EAS_APPLE_TEAM_ID"
      }
    }
  }
}
